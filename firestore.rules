rules_version = '2';

// Paste these into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isSchoolUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && myEmail().matches('.*@zispp[.]org');
    }

    function adminPath(email) {
      return /databases/$(database)/documents/admins/$(email);
    }

    function isAdmin() {
      return isSchoolUser() && exists(adminPath(myEmail()));
    }

    // The master admin is set by hand in the Firebase console (super: true).
    function isSuper() {
      return isAdmin() && get(adminPath(myEmail())).data.get('super', false) == true;
    }

    function tripIsOpen(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.isOpen == true;
    }

    function studentPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId)/students/$(myEmail());
    }

    function seatPath(tripId, seatKey) {
      return /databases/$(database)/documents/trips/$(tripId)/seats/$(seatKey);
    }

    function busPath(tripId, busId) {
      return /databases/$(database)/documents/trips/$(tripId)/buses/$(busId);
    }

    // admins/{email}: teachers. Only the master admin can add or remove them, and
    // nobody can make an account a master admin from the app.
    match /admins/{email} {
      allow get: if isSchoolUser() && (email == myEmail() || isSuper());
      allow list: if isSuper();
      allow create: if isSuper()
        && email.matches('[^A-Z]*@zispp[.]org')
        && request.resource.data.keys().hasOnly(['addedBy', 'addedAt'])
        && request.resource.data.addedBy == myEmail();
      allow delete: if isSuper() && resource.data.get('super', false) != true;
    }

    match /trips/{tripId} {
      allow read: if isSchoolUser();
      allow write: if isAdmin();

      // buses/{busId} = { name, rows, seatsPerRow, order }
      match /buses/{busId} {
        allow read: if isSchoolUser();
        allow write: if isAdmin();
      }

      // seats/{busId_seat} = one doc per taken seat. "create" fails if the seat already
      // exists, so a student can never overwrite someone else's seat.
      match /seats/{seatKey} {
        allow read: if isSchoolUser();
        allow update: if isAdmin();
        allow create: if isAdmin() || (
          isSchoolUser()
          && tripIsOpen(tripId)
          && request.resource.data.keys().hasOnly(['busId', 'seat', 'studentEmail', 'studentName', 'takenAt'])
          && request.resource.data.studentEmail == myEmail()
          && request.resource.data.seat.matches('[1-9][0-9]?[A-F]')
          && seatKey == request.resource.data.busId + '_' + request.resource.data.seat
          && exists(busPath(tripId, request.resource.data.busId))
          // The student's record must point at this seat after the write...
          && getAfter(studentPath(tripId)).data.seatKey == seatKey
          // ...and their previous seat (if any) must be freed in the same write.
          && (!exists(studentPath(tripId))
              || !existsAfter(seatPath(tripId, get(studentPath(tripId)).data.get('seatKey', 'none'))))
        );
        allow delete: if isAdmin() || (
          isSchoolUser()
          && tripIsOpen(tripId)
          && resource.data.studentEmail == myEmail()
        );
      }

      // students/{email} = { seatKey }. Guarantees one seat per student per trip.
      match /students/{email} {
        allow read: if isAdmin() || (isSchoolUser() && email == myEmail());
        allow write: if isAdmin();
        allow create, update: if isSchoolUser()
          && tripIsOpen(tripId)
          && email == myEmail()
          && request.resource.data.keys().hasOnly(['seatKey'])
          && getAfter(seatPath(tripId, request.resource.data.seatKey)).data.studentEmail == myEmail();
        allow delete: if isSchoolUser() && tripIsOpen(tripId) && email == myEmail();
      }
    }
  }
}
